{
  "name": "bug-fix-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "for f in src/*.test.ts; do echo \"== $f\"; tsx $f || exit 1; done"
  },
