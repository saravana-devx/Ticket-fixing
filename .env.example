# --- LLM (see src/llm/) ---
LLM_PROVIDER=groq            # groq | gemini
GROQ_API_KEY=your_groq_api_key
GOOGLE_API_KEY=              # only if LLM_PROVIDER=gemini
# LLM_MODEL=openai/gpt-oss-120b   # optional; default is per provider
# PLANNER_MODEL= / CODER_MODEL= / REVIEWER_MODEL=   # optional per-step override
# LLM_DELAY_MS=3000                   # optional min gap between LLM calls (rate limit)

GITHUB_TOKEN=your_github_personal_access_token
# The TARGET repo: where the agent's issues and PRs are created
GITHUB_OWNER=saravana-devx
GITHUB_REPO=Test-app

USE_LOCAL_TICKET=true
LOCAL_TICKET_PATH=../Test-app/tickets/ticket-001.json

# Repo the agent edits/commits/pushes in (default: the agent's own directory)
TARGET_REPO_PATH=../Test-app
# Log issues/PRs instead of creating them on GitHub (for local testing)
GITHUB_DRY_RUN=true
